# API Configuration
VITE_API_BASE_URL=https://sellsathi-refactored.onrender.com
VITE_API_URL=https://sellsathi-refactored.onrender.com

# Opts back into the mock/dev OTP shortcut on this deployed build (see
# AuthModal.jsx / authController.js ALLOW_TEST_LOGIN). With this set, any
# phone number is accepted and a fake OTP is shown on-screen instead of a
# real SMS being sent - same behavior as localhost. Remove this once real
# Firebase Phone Auth (SMS delivery) is set up for production, since it
# means anyone can log in as any phone number without proving they own it.
VITE_ALLOW_TEST_LOGIN=true