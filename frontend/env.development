# Used ONLY by `npm run dev` (Vite layers .env.development on top of .env in
# development mode; `npm run build` / production deploys ignore this file).
#
# Local dev talks to the LOCAL backend (backend/, port 5000), which loads
# backend/serviceAccountKey.json = the goodkart Firebase project. This keeps
# every login / registration / order write in the goodkart database.
#
# Start it with `npm run dev` from the repo root (frontend + backend together)
# or `npm run dev` inside backend/. Restart the Vite dev server after
# adding/changing this file.
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
